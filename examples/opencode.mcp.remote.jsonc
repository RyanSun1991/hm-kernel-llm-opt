{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "hmopt_kernel_index_remote": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:7331/mcp",
      "headers": {
        "Authorization": "Bearer {env:HMOPT_MCP_SERVER_API_KEY}"
      },
      "timeout": 30000
    },
    "hmopt_build_mcp": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:7335/mcp",
      "headers": {
        "Authorization": "Bearer {env:HMOPT_MCP_SERVER_API_KEY}"
      },
      "timeout": 1800000
    },
    "hmopt_git_remote": {
      "type": "remote",
      "enabled": true,
      "url": "http://127.0.0.1:7334/mcp",
      "timeout": 30000
    }
  }
}
