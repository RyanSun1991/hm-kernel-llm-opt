{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "hmopt_kernel_index": {
      "type": "local",
      "enabled": true,
      "command": [
        "python3",
        "-m",
        "hmopt.api.mcp_stdio"
      ],
      "environment": {
        "HMOPT_MCP_CONFIG": "/ABSOLUTE/PATH/TO/hm-verif-opt-platform_codex/configs/app.yaml",
        "HMOPT_LLM_API_KEY": "{env:HMOPT_LLM_API_KEY}",
        "HMOPT_MCP_TOOL_NAME": "kernel_index_code"
      },
      "timeout": 30000
    }
  }
}
