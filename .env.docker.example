# ===== Required / 必填 =====
KERNEL_REPO_PATH=/absolute/path/to/hm-verif-kernel
# 必须是绝对路径（用于额外挂载到容器同名路径，兼容 compile_commands.json 的 host 绝对路径）
# kernel 工作区根目录（应同时包含 hm-verif-kernel 与 build_tools）
KERNEL_WORKSPACE_PATH=/absolute/path/to/kernel/hongmeng
KERNEL_REPO_GIT_URL=

# ===== Base image (single-container with embedded Neo4j) / 基础镜像（单容器内置Neo4j） =====
HMOPT_BASE_IMAGE=kernel.dockerhub.rnd.huawei.com/hmci-docker-image:v3-4.2
HMOPT_BASE_IMAGE_CANDIDATES=kernel.dockerhub.rnd.huawei.com/hmci-docker-image:v3-4.2,python:3.10-slim

# insecure-registry 动作使用的镜像仓库域名
REGISTRY_HOST=kernel.dockerhub.rnd.huawei.com

# ===== Huawei PyPI mirror / pip 华为源 =====
PIP_INDEX_URL=https://mirrors.tools.huawei.com/pypi/simple
PIP_TRUSTED_HOST=mirrors.tools.huawei.com

# ===== Neo4j apt source (single-container install) / Neo4j apt 源配置 =====
NEO4J_REPO_URL=https://debian.neo4j.com
# Match your host command: disable peer verify for neo4j apt endpoint if needed.
# 对齐你主机安装命令：必要时关闭 neo4j apt 端点证书校验。
NEO4J_VERIFY_PEER=false
# offline: use host-downloaded neo4j deb in docker/neo4j-offline
# online: fetch from debian.neo4j.com during docker build
NEO4J_INSTALL_MODE=offline

# ===== Runtime =====
HMOPT_START_NEO4J=1
NEO4J_USER=neo4j
NEO4J_PASSWORD=@huawei2026

HMOPT_LLM_BASE_URL=http://host.docker.internal:20010/v1
HMOPT_LLM_API_KEY=REPLACE_ME
HMOPT_LLM_MODEL=glm-4.7
HMOPT_EMBEDDING_MODEL=qwen3-embedding-8b
HMOPT_MCP_SERVER_API_KEY=
# 允许通过 Host header 校验的地址（逗号分隔），例如: 10.123.104.145:7331,10.123.104.145:*,localhost:*,127.0.0.1:*
HMOPT_MCP_ALLOWED_HOSTS=localhost:*,127.0.0.1:*
# 如需完全关闭 Host header 校验（不推荐生产）可设为 1
HMOPT_MCP_DISABLE_HOST_CHECK=0
HMOPT_SEQ_MCP_HOST=0.0.0.0
HMOPT_SEQ_MCP_PORT=7333
# 可选：把 compile_commands.json 里的旧前缀映射到当前机器路径
# 例：HMOPT_PATH_ALIAS=/home/ryan/code/scratch/tongkun/hione/work/trunk_new/kernel/hongmeng:/home/irtos/code/scratch/tongkun/hione/work/trunk_new/kernel/hongmeng
HMOPT_PATH_ALIAS=

# Offline delivery bundle path
IMAGE_BUNDLE_TAR=dist/hmopt_bundle.tar.gz

# Optional index overrides (mapped into container path)
# 可选：覆盖 index 命令参数（注意应使用容器内路径）
INDEX_REPO_PATH=/workspace/kernel
INDEX_COMPILE_COMMANDS_DIR=/workspace/kernel
