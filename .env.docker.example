# ===== Required / 必填 =====
KERNEL_REPO_PATH=/home/ryan/code/scratch/tongkun/hione/work/trunk/kernel/hongmeng/hm-verif-kernel/
KERNEL_REPO_GIT_URL=

# ===== Base image (single-container with embedded Neo4j) =====
HMOPT_BASE_IMAGE=kernel.dockerhub.rnd.huawei.com/hmci-docker-image:v3-7.0
HMOPT_BASE_IMAGE_CANDIDATES=kernel.dockerhub.rnd.huawei.com/hmci-docker-image:v3-7.0,kernel.dockerhub.rnd.huawei.com/hmci-docker-image:v3-5.0,kernel.dockerhub.rnd.huawei.com/hmci-docker-image:v3-4.2

# insecure-registry 动作使用的镜像仓库域名
REGISTRY_HOST=kernel.dockerhub.rnd.huawei.com

# ===== Huawei PyPI mirror / pip 华为源 =====
PIP_INDEX_URL=https://mirrors.tools.huawei.com/pypi/simple
PIP_TRUSTED_HOST=mirrors.tools.huawei.com

# ===== Neo4j apt source (single-container install) / Neo4j apt 源配置 =====
NEO4J_REPO_URL=https://debian.neo4j.com
# Match your host command: disable peer verify for neo4j apt endpoint if needed.
NEO4J_VERIFY_PEER=false
NEO4J_INSTALL_MODE=offline

# ===== Runtime =====
HMOPT_START_NEO4J=1
NEO4J_USER=neo4j
NEO4J_PASSWORD=@huawei2026

HMOPT_LLM_BASE_URL=http://10.90.56.33:20010/v1
HMOPT_LLM_API_KEY=
HMOPT_LLM_MODEL=glm-4.7
HMOPT_EMBEDDING_MODEL=qwen3-embedding-8b
HMOPT_MCP_SERVER_API_KEY=

# Offline delivery bundle path
IMAGE_BUNDLE_TAR=hmopt_bundle.tar.gz


# exec: docker exec into existing build container; run: docker run a dedicated build image
HMOPT_BUILD_MCP_MODE=exec
HMOPT_BUILD_MCP_RUNNER_CONTAINER=423553b938cb
# NOTE: RUNNER_CONTAINER must be a running container name/id (docker ps), not image name
HMOPT_BUILD_MCP_RUNNER_IMAGE=ryan-hione-img:latest
# workspace mapping mode (recommended for your workflow):
# host path, e.g. /home/ryan/code/scratch/tongkun/hione/work
HMOPT_BUILD_MCP_HOST_WORKDIR=/home/ryan/code/scratch/tongkun/hione/work/
# mapped container root path, e.g. /work
HMOPT_BUILD_MCP_CONTAINER_WORKDIR=/work/
# code path under container root, e.g. trunk_new
HMOPT_BUILD_MCP_CODE_SUBPATH=trunk/
# install lz4 policy before build: auto(run mode only) | always | never
HMOPT_BUILD_MCP_INSTALL_LZ4=auto
# hm-CI path for do_pack_hione_trunk.sh
HMOPT_BUILD_MCP_SIGN_WORKSPACE=hm-CI/

HMOPT_BUILD_PASSWD=
HMOPT_BUILD_USERNAME=

