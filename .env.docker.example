# ===== Required / 必填 =====
# Optional but recommended when kernel git metadata depends on parent project repo.
# 建议配置：当 kernel 的 git 元信息依赖上层工程仓时，挂载整个工程根目录。
PROJECT_REPO_PATH=/path/to/hione/work/trunk/
KERNEL_REPO_PATH=/path/to/hione/work/trunk/kernel/hongmeng/hm-verif-kernel/
KERNEL_REPO_GIT_URL=

# ===== Base image (single-container with embedded Neo4j) =====
HMOPT_BASE_IMAGE=YOUR_REGISTRY/hmci-docker-image:v3-7.0
HMOPT_BASE_IMAGE_CANDIDATES=YOUR_REGISTRY/hmci-docker-image:v3-7.0,YOUR_REGISTRY/hmci-docker-image:v3-5.0

# insecure-registry 动作使用的镜像仓库域名
REGISTRY_HOST=YOUR_REGISTRY

# ===== Huawei PyPI mirror / pip 华为源 =====
PIP_INDEX_URL=https://pypi.org/simple
PIP_TRUSTED_HOST=pypi.org

# ===== Neo4j apt source (single-container install) / Neo4j apt 源配置 =====
NEO4J_REPO_URL=https://debian.neo4j.com
# Match your host command: disable peer verify for neo4j apt endpoint if needed.
NEO4J_VERIFY_PEER=false
NEO4J_INSTALL_MODE=offline

# ===== Runtime =====
HMOPT_START_NEO4J=1
NEO4J_USER=neo4j
NEO4J_PASSWORD=

HMOPT_LLM_BASE_URL=http://LLM_GATEWAY_HOST:PORT/v1
HMOPT_LLM_API_KEY=
HMOPT_LLM_MODEL=glm-4.7
HMOPT_EMBEDDING_MODEL=qwen3-embedding-8b
HMOPT_MCP_SERVER_API_KEY=
# Additional safe.directory entries (comma-separated) applied on container start.
# 启动容器时追加 git safe.directory（逗号分隔，可选）。
HMOPT_GIT_SAFE_DIRECTORIES=

# ===== Team Memory / Skill Hub MCP =====
# Host directory persisted into the 7338 service at /data/team-memory.
# 7338 服务端的个人 journal 持久化目录（宿主机路径）。
HMOPT_MEMBER_MEMORY_HOST_ROOT=./data/team-memory
# Optional default contributor for a single-user deployment; callers may override it.
HMOPT_MEMBER_CONTRIBUTOR=opencode
# Optional explicit team hub checkout; auto-discovered from /app when empty.
HMOPT_SKILLHUB_HUB_ROOT=

# Run container as host UID/GID to align file ownership and reduce git safe.directory issues.
# 以宿主机 UID/GID 启动容器（尽量与 host 权限一致，降低 git safe.directory 问题）。
# Note: when HMOPT_START_NEO4J=1, docker_oneclick.sh falls back to root runtime by default for neo4j compatibility.
# 说明：当 HMOPT_START_NEO4J=1 时，脚本默认回退为 root 运行以兼容 neo4j。
# Even with the fallback above, git-mcp/safe.directory steps still use host UID/GID when enabled.
# 即使回退为 root，git-mcp 与 safe.directory 仍可按 host UID/GID 执行。
HMOPT_RUN_AS_HOST_USER=1
# Force host UID/GID even when HMOPT_START_NEO4J=1 (may cause neo4j startup issues).
# 即使 HMOPT_START_NEO4J=1 也强制使用 host UID/GID（可能导致 neo4j 启动问题）。
HMOPT_FORCE_HOST_USER_WITH_NEO4J=0
# Optional overrides. Leave empty to auto-detect from current shell (id -u / id -g).
# 可选覆盖；留空则自动使用当前 shell 的 id -u / id -g。
HMOPT_HOST_UID=
HMOPT_HOST_GID=
# Inherit host ~/.gitconfig into container so git commit has global user.name/user.email.
# 将 host 的 ~/.gitconfig 挂载进容器，避免 git commit 缺少全局 name/email。
HMOPT_INHERIT_HOST_GITCONFIG=1
# Optional explicit host gitconfig path.
# 可选：显式指定 host gitconfig 路径。
HMOPT_GITCONFIG_SOURCE=

# Offline delivery bundle path
IMAGE_BUNDLE_TAR=hmopt_bundle.tar.gz


# exec: docker exec into existing build container; run: docker run a dedicated build image
HMOPT_BUILD_MCP_MODE=exec
HMOPT_BUILD_MCP_RUNNER_CONTAINER=423553b938cb
# NOTE: RUNNER_CONTAINER must be a running container name/id (docker ps), not image name
HMOPT_BUILD_MCP_RUNNER_IMAGE=ryan-hione-img:latest
# workspace mapping mode (recommended for your workflow):
# host path, e.g. /path/to/hione/work
HMOPT_BUILD_MCP_HOST_WORKDIR=/path/to/hione/work/
# mapped container root path, e.g. /work
HMOPT_BUILD_MCP_CONTAINER_WORKDIR=/work/
# code path under container root, e.g. trunk_new
HMOPT_BUILD_MCP_CODE_SUBPATH=trunk/
# install lz4 policy before build: auto(run mode only) | always | never
HMOPT_BUILD_MCP_INSTALL_LZ4=auto
# hm-CI path for do_pack_hione_trunk.sh
HMOPT_BUILD_MCP_SIGN_WORKSPACE=hm-CI/

HMOPT_BUILD_PASSWD=
HMOPT_BUILD_USERNAME=

# ===== Flash MCP / Windows Device Relay =====
HMOPT_FLASH_RELAY_URL=http://WINDOWS_PC_IP:9100
HMOPT_FLASH_RELAY_SECRET=
HMOPT_FLASH_MCP_HOST=0.0.0.0
HMOPT_FLASH_MCP_PORT=7337
HMOPT_FLASH_DEVICE_SERIAL=
# Stock image directory on the build server (baseline for A/B testing)
HMOPT_FLASH_STOCK_IMAGE_DIR=/path/to/hione/work/trunk/hm-CI/hione_trunk/stock/
# Feature image directory on the build server (patched kernel for A/B testing)
HMOPT_FLASH_FEATURE_IMAGE_DIR=/path/to/hione/work/trunk/hm-CI/hione_trunk/aln_user/
# Default partitions to flash (comma-separated partition:filename pairs)
HMOPT_FLASH_DEFAULT_PARTITIONS=boot:boot.img,modem_driver:modem_driver.img
HMOPT_FLASH_SERVER_IMAGE_PREFIX=
HMOPT_FLASH_WINDOWS_IMAGE_PREFIX=

# Image transfer (pscp from build server to Windows PC)
HMOPT_FLASH_SCP_TOOL=pscp
HMOPT_FLASH_SCP_HOST=WINDOWS_PC_IP
HMOPT_FLASH_SCP_USER=YOUR_WINDOWS_USER
HMOPT_FLASH_SCP_PASSWORD=
HMOPT_FLASH_WINDOWS_IMAGE_DIR=.
HMOPT_FLASH_PIPELINE_SCRIPT=flash_pipeline.py

# ===== Auto-Test MCP =====
# Default device target for `hdc -t <target> ...`; leave empty to pass target per MCP call.
HMOPT_AUTO_TEST_TARGET=
# Default connect mode. Set to `none` to skip `hdc connect/tconn` and use direct `hdc -t ...`.
HMOPT_AUTO_TEST_HDC_CONNECT_MODE=none
