# LLM server
HMOPT_LLM_BASE_URL=http://LLM_GATEWAY_HOST:PORT/v1
HMOPT_LLM_API_KEY=REPLACE_ME
HMOPT_LLM_MODEL=qwen3-coder-30b

# Networking (Windows proxy workaround example)
# no_proxy=LLM_GATEWAY_HOST

# Flash MCP / Windows Device Relay
HMOPT_FLASH_RELAY_URL=http://WINDOWS_PC_IP:9100
HMOPT_FLASH_RELAY_SECRET=
HMOPT_FLASH_MCP_HOST=0.0.0.0
HMOPT_FLASH_MCP_PORT=7337
HMOPT_FLASH_DEVICE_SERIAL=
HMOPT_FLASH_STOCK_IMAGE_DIR=/path/to/stock/boot/images
# Feature image directory on the build server (patched kernel for A/B testing)
HMOPT_FLASH_FEATURE_IMAGE_DIR=/path/to/feature/boot/images
# Default partitions to flash (comma-separated partition:filename pairs)
HMOPT_FLASH_DEFAULT_PARTITIONS=boot:boot.img,modem_driver:modem_driver.img
HMOPT_FLASH_SERVER_IMAGE_PREFIX=
HMOPT_FLASH_WINDOWS_IMAGE_PREFIX=

# Image transfer (pscp from build server to Windows PC)
HMOPT_FLASH_SCP_TOOL=pscp
HMOPT_FLASH_SCP_HOST=WINDOWS_PC_IP
HMOPT_FLASH_SCP_USER=YOUR_WINDOWS_USER
HMOPT_FLASH_SCP_PASSWORD=
HMOPT_FLASH_WINDOWS_IMAGE_DIR=.
# Path to flash_pipeline.py on the Windows PC (co-located with relay_service.py)
HMOPT_FLASH_PIPELINE_SCRIPT=flash_pipeline.py
